{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thisisjoewells-emdash-cms-1",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thisisjoewells-emdash-cms-1","database_id": "029b7604-7c67-4f5f-99e1-46c4068defc4",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "thisisjoewells-emdash-cms1-bucket1","preview_bucket_name": "thisisjoewells-emdash-cms1-bucket1",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
